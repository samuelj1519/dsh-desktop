{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "outDir": "lib",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ]
}
